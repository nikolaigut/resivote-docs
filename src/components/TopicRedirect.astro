<script is:inline>
	(function () {
		const topicMap = {
			users: '/guides/benutzer/',
			owners: '/guides/benutzer/',
			benutzer: '/guides/benutzer/',
			'app/users': '/guides/benutzer/',
			'admin/owners': '/guides/benutzer/',
			'admin/communities': '/guides/benutzer/',
			communities: '/guides/benutzer/',
			meetings: '/guides/so-funktioniert/',
			versammlungen: '/guides/so-funktioniert/',
			'admin/meetings': '/guides/versammlung-erstellen/',
			'admin/documents': '/guides/dokumente/',
			'admin/documents/templates': '/guides/dokumente/',
			documents: '/guides/dokumente/',
			'portal/meetings': '/guides/so-funktioniert/',
			'portal/documents': '/guides/dokumente/',
			'portal/tickets': '/guides/dokumente/',
			'meeting/chair': '/guides/abstimmung/',
			'meeting/protocol': '/guides/protokoll/',
			'meeting/tablet-checkin': '/guides/checkin/',
			'meeting/checkin': '/guides/checkin/',
			voting: '/guides/abstimmung/',
			checkin: '/guides/checkin/',
			quorum: '/guides/quorum/',
			proxies: '/guides/vollmachten/',
			vollmachten: '/guides/vollmachten/',
			protocol: '/guides/protokoll/',
		};
		const params = new URLSearchParams(window.location.search);
		const topic = params.get('topic') || params.get('from');
		if (topic) {
			const normalized = topic.replace(/^\/+/, '').replace(/\/\d+.*$/, '').toLowerCase();
			const target = topicMap[topic.toLowerCase()] || topicMap[normalized];
			if (target && target !== window.location.pathname) {
				window.location.replace(target + window.location.search);
			}
		}
	})();
</script>
