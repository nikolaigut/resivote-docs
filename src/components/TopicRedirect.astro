<script is:inline>
	(function () {
		const topicMap = {
			users: '/verwaltung/uebersicht/',
			owners: '/verwaltung/liegenschaften-eigentuemer/',
			benutzer: '/verwaltung/uebersicht/',
			'app/users': '/verwaltung/uebersicht/',
			'admin/owners': '/verwaltung/liegenschaften-eigentuemer/',
			'admin/communities': '/verwaltung/liegenschaften-eigentuemer/',
			communities: '/verwaltung/liegenschaften-eigentuemer/',
			meetings: '/eigentuemer/versammlung-mit-login/',
			versammlungen: '/eigentuemer/versammlung-mit-login/',
			'admin/meetings': '/verwaltung/versammlung-erstellen/',
			'admin/documents': '/verwaltung/dokumente-vorlagen/',
			'admin/documents/templates': '/verwaltung/dokumente-vorlagen/',
			documents: '/eigentuemer/dokumente/',
			portal: '/eigentuemer/portal/',
			'portal/overview': '/eigentuemer/portal/',
			dashboard: '/eigentuemer/portal/',
			'portal/meetings': '/eigentuemer/versammlung-mit-login/',
			'portal/documents': '/eigentuemer/dokumente/',
			'portal/tickets': '/eigentuemer/tickets/',
			tickets: '/eigentuemer/tickets/',
			'admin/tickets': '/verwaltung/tickets-pendenzen/',
			'portal/messages': '/eigentuemer/mitteilungen/',
			messages: '/eigentuemer/mitteilungen/',
			mitteilungen: '/eigentuemer/mitteilungen/',
			'admin/messages': '/verwaltung/mitteilungen/',
			'portal/forum': '/eigentuemer/forum/',
			forum: '/eigentuemer/forum/',
			'admin/forum': '/verwaltung/forum-moderation/',
			'portal/notifications': '/eigentuemer/benachrichtigungen/',
			'portal/notifications/settings': '/eigentuemer/benachrichtigungen/',
			notifications: '/eigentuemer/benachrichtigungen/',
			benachrichtigungen: '/eigentuemer/benachrichtigungen/',
			zirkularbeschluss: '/eigentuemer/zirkularbeschluss/',
			circular: '/eigentuemer/zirkularbeschluss/',
			'meeting/chair': '/verwaltung/versammlungssteuerung/',
			'meeting/protocol': '/verwaltung/protokoll/',
			'meeting/tablet-checkin': '/verwaltung/checkin-praesenz/',
			'meeting/checkin': '/eigentuemer/checkin/',
			voting: '/eigentuemer/versammlung-mit-login/',
			saal: '/eigentuemer/versammlung-ohne-login/',
			checkin: '/eigentuemer/checkin/',
			quorum: '/verwaltung/quorum/',
			proxies: '/eigentuemer/vollmachten/',
			vollmachten: '/eigentuemer/vollmachten/',
			protocol: '/verwaltung/protokoll/',
		};
		const params = new URLSearchParams(window.location.search);
		const topic = params.get('topic') || params.get('from');
		if (topic) {
			const normalized = topic.replace(/^\/+/, '').replace(/\/\d+.*$/, '').toLowerCase();
			const target = topicMap[topic.toLowerCase()] || topicMap[normalized];
			if (target && target !== window.location.pathname) {
				window.location.replace(target + window.location.search);
			}
		}
	})();
</script>
